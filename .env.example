# Database
DATABASE_URL=data/social-sanity.db

# The app's clone of the posts repository (defaults to data/repo)
# REPO_DIR=data/repo

# Largest accepted request body in production (adapter-node); uploads include video files.
BODY_SIZE_LIMIT=300M

# Encryption of OAuth tokens and app secrets — generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# Public origin of this app, used for OAuth redirect URIs (defaults to the request origin).
# Instagram requires HTTPS redirect URIs, so use a tunnel or real host for it.
# Instagram also fetches post media from <PUBLIC_BASE_URL>/media/...
# unless the file upload integration has a public URL.
PUBLIC_BASE_URL=

# FTP/SFTP upload — configured on the Integrations page. The password lives only in the environment,
# under a variable name you choose there (FTP_PASSWORD is the suggested default).
# FTP_PASSWORD=

# Posts repository — configured on the Settings page. For HTTPS, the token lives only in the
# environment under a variable name you choose there. SSH uses this machine's keys.
# POSTS_REPO_TOKEN=
