# Social Sanity reads these from the environment. Keep the values in ~/.zshenv as
#   export SOCIAL_SANITY_TOKEN_ENC_KEY='…'
# or in a git-ignored .env next to this file; a value set in the shell wins.

# SQLite database file, relative to where the app is started.
SOCIAL_SANITY_DATABASE_URL=data/social-sanity.db

# Encryption of OAuth tokens and app secrets — generate with: openssl rand -base64 32
SOCIAL_SANITY_TOKEN_ENC_KEY=

# Public origin of this app, used for OAuth redirect URIs (defaults to the request origin).
# Instagram requires HTTPS redirect URIs, so use a tunnel or real host for it.
# Instagram also fetches post media from <SOCIAL_SANITY_PUBLIC_BASE_URL>/media/...
# unless the file upload integration has a public URL.
# SOCIAL_SANITY_PUBLIC_BASE_URL=

# The app's clone of the posts repository (defaults to data/repo).
# SOCIAL_SANITY_REPO_DIR=data/repo

# adapter-node settings for `node build` carry the same prefix.
# Uploads include video files, so raise the request body limit.
# SOCIAL_SANITY_SERVER_HOST=127.0.0.1
# SOCIAL_SANITY_SERVER_BODY_SIZE_LIMIT=300M

# FTP/SFTP upload — configured on the Integrations page. The password lives only in the environment,
# under a variable name you choose there (SOCIAL_SANITY_FTP_PWD is the suggested default).
# SOCIAL_SANITY_FTP_PWD=

# Posts repository — configured on the Integrations page. For HTTPS, the token lives only in the
# environment under a variable name you choose there. SSH uses this machine's keys.
# SOCIAL_SANITY_REPO_TOKEN=

# Backups over the API: GET /api/backup with "Authorization: Bearer <token>" returns the database.
# Off while unset. At least 32 characters, e.g. openssl rand -hex 32.
# SOCIAL_SANITY_BACKUP_TOKEN=
