# Database
DATABASE_URL=data/social-sanity.db

# The app's clone of the posts repository (defaults to data/repo)
# REPO_DIR=data/repo

# Largest accepted request body in production (adapter-node); uploads include video files.
BODY_SIZE_LIMIT=300M

# Auth — generate the hash with: npm run hash-password -- '<your password>'
APP_PASSWORD_HASH=
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# OAuth token encryption — generate with: openssl rand -base64 32
TOKEN_ENC_KEY=

# Public origin of this app, used for OAuth redirect URIs (defaults to the request origin).
# Instagram requires HTTPS redirect URIs, so use a tunnel or real host for it.
# Instagram also fetches post media from <PUBLIC_BASE_URL>/media/... (short-lived signed links)
# unless the file upload integration has a public URL.
PUBLIC_BASE_URL=

# LinkedIn — https://www.linkedin.com/developers/apps
# Redirect URI: <PUBLIC_BASE_URL>/integrations/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Instagram API with Instagram Login — https://developers.facebook.com/apps
# Redirect URI: <PUBLIC_BASE_URL>/integrations/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# FTP/SFTP upload — configured on the Integrations page. The password lives only in the environment,
# under a variable name you choose there (FTP_PASSWORD is the suggested default).
# FTP_PASSWORD=

# Posts repository — configured on the Integrations page. For HTTPS, the token lives only in the
# environment under a variable name you choose there. SSH uses this machine's keys.
# POSTS_REPO_TOKEN=
